# Supabase 接続情報のテンプレート。実際の値は .env（gitignore 済み）に書く。
#
# Vite では VITE_ 接頭辞の変数だけがクライアントに露出する（import.meta.env で参照）。
# ここには publishable キー（sb_publishable_...）を使う。
# service_role（秘密）キーは絶対にここにもクライアントにも置かない。
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
